---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getOrcidPublications } from '../lib/orcid-static-cache';

const ORCID_ID = '0009-0009-4644-0072';

const { publications, fetchError } = await getOrcidPublications(ORCID_ID);
---

<BaseLayout
  title="Research"
  description="Research on search-based optimization, requirement falsification, and output coverage for cyber-physical systems."
>
  <div class="page">
    <h1>Research</h1>
    
    <h2>Research Focus</h2>
    <p>
      My research concerns search-based optimization for testing cyber-physical systems. I work with black-box systems, where the tester selects input signals and evaluates the resulting output signals without access to the system's implementation.
    </p>

    <p>
      I formulate test generation as an optimization problem. Signal Temporal Logic (STL) formalizes the requirements and provides a robustness degree that can be used as a quantitative measure to guide the search toward requirement violations and specified output behavior.
    </p>

    <h2>Current Topics</h2>
    <ul>
      <li><strong>Multi-requirement falsification:</strong> searching for violations of several STL requirements in one search.</li>
      <li><strong>Continuous requirement falsification:</strong> transferring knowledge between system revisions instead of restarting the search after each change.</li>
      <li><strong>Explicit output coverage:</strong> finding a set of inputs whose outputs satisfy a set of STL test requirements.</li>
    </ul>

    <p>
      The aim is to find useful test inputs with fewer executions of the system under test, especially when each software simulation is computationally expensive to run.
    </p>

    <p>
      <strong>PhD thesis:</strong> Requirement Conformance Testing of Cyber-Physical Systems Across Multiple Requirements and Revisions.
    </p>

    <h2>Research Software</h2>
    <p>
      I maintain <a href="https://gitlab.abo.fi/stc/stgem2" target="_blank" rel="noopener noreferrer">stgem (system testing using generative models)</a>, an open-source Python library for developing black-box falsification and test-generation methods. It supports time-varying inputs and outputs, STL requirements, and search methods based on generative models.
    </p>
    
    <h2>Publications</h2>
    {fetchError && (
      <div class="notice">
        <p><strong>Note:</strong> {fetchError}</p>
        <p>Please update your ORCID ID.</p>
      </div>
    )}
    
    {publications.length > 0 ? (
      <div class="publications">
        {publications.map((pub) => (
          <div class="publication">
            <h3 class="pub-title">{pub.title}</h3>
            <div class="pub-meta">
              <span class="pub-year">{pub.year}</span>
              {pub.journal && <span class="pub-journal"> · {pub.journal}</span>}
              {pub.type && <span class="pub-type"> · {pub.type.replace(/-/g, ' ')}</span>}
            </div>
            {pub.url && (
              <div class="pub-links">
                <a href={pub.url} target="_blank" rel="noopener noreferrer">
                  View Publication →
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    ) : !fetchError && (
      <p><em>Loading publications from ORCID...</em></p>
    )}
    
    
    <h2>Research Links</h2>
    <div class="research-links">
      <a class="button" href="https://research.abo.fi/en/persons/jesper-winsten/" target="_blank" rel="noopener noreferrer">Research Profile (ÅAU)</a>
      <a class="button" href={`https://orcid.org/${ORCID_ID}`} target="_blank" rel="noopener noreferrer">ORCID Profile</a>
      <a class="button" href="https://scholar.google.com/citations?user=KbH2RR0AAAAJ&hl=fi&oi=ao" target="_blank" rel="noopener noreferrer">Google Scholar</a>
    </div>
  </div>
</BaseLayout>

<style>
  /* Page-specific styles for research publications */
  .publications {
    margin-top: 1.5rem;
  }

  .publication {
    margin-bottom: 2rem;
  }

  .pub-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.2rem;
    line-height: 1.4;
  }

  .pub-meta {
    color: var(--gray);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .pub-year {
    font-weight: bold;
  }

  .pub-type {
    text-transform: capitalize;
  }

  .pub-links {
    margin-top: 0.5rem;
  }

  .pub-links a {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .pub-links a:hover {
    text-decoration: underline;
  }
</style>
