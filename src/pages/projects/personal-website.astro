---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout title="Personal Website">
  <div class="page">
    <article class="project-detail">
      <header class="project-header">
        <h1>Personal Website</h1>
        <div class="project-meta">
          <span class="status-badge status-completed">Completed</span>
          <span class="project-category">Web Development</span>
        </div>
      </header>

      <section class="project-section">
        <h2>Overview</h2>
        <p>
          I built this site with Astro and host it on Cloudflare Workers. It contains my research, work history,
          and software projects. The design is based on Dennis Klappe's{' '}
          <a href="https://github.com/dennisklappe/astro-theme-terminal" target="_blank" rel="noopener noreferrer">astro-theme-terminal</a>.
        </p>
        <p>
          Astro pre-renders the pages, so the site sends little JavaScript to the browser. The layout also works
          on narrow screens and with keyboard navigation.
        </p>
      </section>

      <section class="project-section">
        <h2>Technologies & Features</h2>
        <ul>
          <li><strong><a href="https://astro.build/">Astro</a></strong> - Pre-renders the site's pages at build time.</li>
          <li><strong><a href="https://www.typescriptlang.org/">TypeScript</a></strong> - Provides static type checking for the site's code.</li>
          <li><strong><a href="https://workers.cloudflare.com/">Cloudflare Workers</a></strong> - Hosts the built site.</li>
          <li><strong>Terminal theme</strong> - Adapts <a href="https://github.com/dennisklappe/astro-theme-terminal" target="_blank" rel="noopener noreferrer">astro-theme-terminal</a> with <a href="https://github.com/tonsky/FiraCode" target="_blank" rel="noopener noreferrer">Fira Code</a> and a responsive layout.</li>
          <li><strong>Syntax highlighting</strong> - Uses <a href="https://shiki.style/">Shiki</a> to highlight code blocks.</li>
          <li><strong><a href="https://postman.orcid.org/" target="_blank" rel="noopener noreferrer">ORCID API</a></strong> - Fetches my publication list during each build and includes it in the generated Research page.</li>
          <li><strong>Privacy</strong> - Uses no analytics, tracking scripts, social-media embeds, or third-party sharing widgets.</li>
          <li><strong>Search indexing</strong> - Generates a sitemap and provides canonical URLs, page descriptions, and semantic HTML.</li>
        </ul>
      </section>

      <section class="project-section">
        <h2>Links</h2>
        <div class="project-links">
          <a href="https://github.com/ItsWinsten/personal-website" target="_blank" rel="noopener noreferrer" class="button">
            View on GitHub
          </a>
          <a href="https://winsten.dev" target="_blank" rel="noopener noreferrer" class="button">
            Live Site
          </a>
        </div>
      </section>

      <div class="back-link">
        <a href={`${base}projects/`}>← Back to Projects</a>
      </div>
    </article>
  </div>
</BaseLayout>
