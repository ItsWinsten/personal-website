---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout title="Mobile App">
  <div class="page">
    <article class="project-detail">
      <header class="project-header">
        <h1>Mobile App</h1>
        <div class="project-meta">
          <span class="status-badge status-in-progress">In Progress</span>
          <span class="project-category">Mobile Development</span>
        </div>
      </header>

      <section class="project-section">
        <h2>Overview</h2>
        <p>
          I am building an open-source community application while learning Flutter. The concept is still being
          developed, so I am not publishing further details yet.
        </p>
        <p>
          The application targets both iOS and Android. I am working on its interface and accessibility alongside
          the core functionality.
        </p>
      </section>

      <section class="project-section">
        <h2>Technologies</h2>
        <ul>
          <li><strong><a href="https://flutter.dev/" target="_blank" rel="noopener noreferrer">Flutter</a></strong> - Builds the iOS and Android applications from one codebase.</li>
        </ul>
      </section>

      <section class="project-section">
        <h2>Project Status</h2>
        <p>
          The project is in active development. Its repository will be linked here when it becomes public.
        </p>
      </section>

      <div class="back-link">
        <a href={`${base}projects/`}>← Back to Projects</a>
      </div>
    </article>
  </div>
</BaseLayout>
