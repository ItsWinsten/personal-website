---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="winsten.dev">
  <div class="page">
    <div class="index-content">
      <div class="profile-intro">
        <img fetchpriority="high" src="/profile.webp" alt="Jesper Winsten" class="profile-image" />
        <div class="profile-summary">
          <h1 id="hello-there">Jesper Winsten</h1>
          <p class="profile-tagline">
            PhD Researcher | Search-Based Software Testing<br/>
            <a href="https://research.abo.fi/en/persons/jesper-winsten/">Åbo Akademi University</a>
          </p>
          <p>
            I develop search-based optimization methods for testing cyber-physical systems against formal requirements.
          </p>
        </div>
      </div>
    </div>

    <section class="index-section">
      <h2>About Me</h2>
      <p>
        I am a PhD researcher in Computer Science at Åbo Akademi University. I study search-based testing and falsification of cyber-physical systems.
      </p>
      <p>
        I treat test generation as an optimization problem: select inputs, run the system, evaluate its outputs against requirements, and use the result to guide the next search. My work focuses on black-box systems whose internal implementation is unavailable to the tester.
      </p>
    </section>

    <section class="index-section">
      <h2>Experience</h2>
      <div class="timeline-item">
        <div class="timeline-header">
          <h3>PhD Researcher</h3>
        </div>
        <div class="timeline-subtitle">
          <span>Åbo Akademi University</span>
          <span class="timeline-date">2022 - Present</span>
        </div>
        <p>Researching search-based optimization for testing cyber-physical systems. My work includes multi-requirement falsification, continuous requirement falsification, and explicit output coverage.</p>
      </div>
      
      <div class="timeline-item">
        <div class="timeline-header">
          <h3>Machine Learning Engineer</h3>
        </div>
        <div class="timeline-subtitle">
          <span>Everon Oy Ab</span>
          <span class="timeline-date">2022</span>
        </div>
        <p>
          Developed machine learning software for welfare technology under privacy, security, and GDPR constraints. One project used on-device pose detection to identify falls and unusual inactivity. Raw camera data remained on the device; it only sent alerts to caregivers.
        </p>
      </div>
    </section>

    <section class="index-section">
      <h2>Education</h2>
      <div class="timeline-item">
        <div class="timeline-header">
          <h3>Doctor of Philosophy in Computer Science</h3>
        </div>
        <div class="timeline-subtitle">
          <span>Åbo Akademi University</span>
          <span class="timeline-date">2022 - Present</span>
        </div>
        <p>Research focus: scalable, search-based falsification of multiple Signal Temporal Logic requirements for cyber-physical systems.</p>
      </div>
      
      <div class="timeline-item">
        <div class="timeline-header">
          <h3>Master of Science in Computer Science</h3>
        </div>
        <div class="timeline-subtitle">
          <span>Åbo Akademi University and Reykjavik University</span>
          <span class="timeline-date">2020 - 2022</span>
        </div>
        <p>Double degree completed through the Nordic Master Programme in Intelligent Software Systems (NISS).</p>
        <div class="degree-details" aria-label="Master's degree details by university">
          <div class="degree-detail">
            <h4>Åbo Akademi University</h4>
            <p><strong>Degree:</strong> Computer Science</p>
            <p><strong>Main module:</strong> Computational Data Analytics</p>
          </div>
          <div class="degree-detail">
            <h4>Reykjavik University</h4>
            <p><strong>Degree:</strong> Computer Science</p>
            <p><strong>Main module:</strong> Intelligent Software Systems</p>
          </div>
        </div>
        <p><strong>Thesis: Deep learning approaches for ship detection from inshore and offshore imagery.</strong></p>
      </div>
      
      <div class="timeline-item">
        <div class="timeline-header">
          <h3>Bachelor of Science in Computer Science</h3>
        </div>
        <div class="timeline-subtitle">
          <span>Åbo Akademi University</span>
          <span class="timeline-date">2017 - 2020</span>
        </div>
        <p>Minor studies: Biochemistry.</p>
        <p><strong>Thesis: Utilization of connection sequences for connecting devices to fake Wi-Fi networks.</strong></p>
      </div>
    </section>



  </div>
</BaseLayout>

<style>
  .profile-intro {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .profile-summary {
    flex: 1;
    min-width: 300px;
  }

  .profile-summary h1 {
    margin-top: 0;
  }

  .profile-tagline {
    font-size: 1.1rem;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .profile-image {
    margin-top: 0;
  }

  .index-section h2 {
    color: var(--accent);
    margin-top: 3rem;
    padding-top: 2rem;
    padding-bottom: 0.5rem;
    border-top: 2px solid var(--accent);
    font-size: 1.5rem;
  }

  .index-section + .index-section h2 {
    border-top: 2px solid var(--accent);
  }

  .timeline-item {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .timeline-item:last-child {
    border-bottom: none;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  .timeline-header h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--accent) 80%, transparent);
  }

  .timeline-date {
    color: var(--accent);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .timeline-subtitle {
    font-size: 1rem;
    color: var(--foreground);
    margin: 0.25rem 0 0.75rem 0;
    font-weight: 500;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .timeline-item p:last-child {
    margin-bottom: 0;
  }

  .degree-details {
    display: grid;
    gap: 0.8rem;
    margin: 0.9rem 0 1rem;
  }

  .degree-detail {
    border-left: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
    padding: 0.55rem 0 0.55rem 0.85rem;
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .degree-detail h4 {
    margin: 0 0 0.35rem 0;
    font-size: 0.92rem;
    color: var(--accent);
  }

  .degree-detail p {
    margin: 0.15rem 0;
    font-size: 0.9rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--foreground) 82%, transparent);
  }

  .degree-detail p:last-child {
    margin-bottom: 0;
  }
</style>
