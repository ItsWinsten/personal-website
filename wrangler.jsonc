{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2026-07-13",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "winsten.dev/*",
      "zone_name": "winsten.dev"
    },
    {
      "pattern": "www.winsten.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
